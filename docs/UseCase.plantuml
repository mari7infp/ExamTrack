@startuml
left to right direction
skinparam packageStyle rectangle

actor "Администратор" as Admin
actor "Преподаватель" as Teacher

rectangle "Информационная система «ExamTrack»" {
  
  ' Общий прецедент
  usecase "Вход в систему (авторизация)" as UC_Login
  
  ' Прецеденты администратора (слева)
  usecase "Регистрация пользователей" as UC_RegUsers
  usecase "Добавление студента" as UC_AddStudent
  usecase "Редактирование данных студента" as UC_EditStudent
  usecase "Удаление студента" as UC_DeleteStudent
  usecase "Добавление дисциплины" as UC_AddDiscipline
  usecase "Редактирование дисциплины" as UC_EditDiscipline
  usecase "Удаление дисциплины" as UC_DeleteDiscipline
  usecase "Формирование экзаменационной ведомости" as UC_CreateStatement
  usecase "Закрытие экзаменационной ведомости" as UC_CloseStatement
  usecase "Формирование отчётов по успеваемости" as UC_CreateReports
  
  ' Прецеденты преподавателя (справа)
  usecase "Заполнение экзаменационной ведомости" as UC_FillStatement
  usecase "Просмотр списка студентов" as UC_ViewStudents
  usecase "Поиск студента" as UC_SearchStudent
  usecase "Просмотр справочника дисциплин" as UC_ViewDisciplines
}

' Связи для входа в систему (по центру)
Admin -- UC_Login
UC_Login -- Teacher

' Связи администратора (отрисовываются слева)
Admin -- UC_RegUsers
Admin -- UC_AddStudent
Admin -- UC_EditStudent
Admin -- UC_DeleteStudent
Admin -- UC_AddDiscipline
Admin -- UC_EditDiscipline
Admin -- UC_DeleteDiscipline
Admin -- UC_CreateStatement
Admin -- UC_CloseStatement
Admin -- UC_CreateReports

' Связи преподавателя (записаны в обратном порядке для отрисовки справа)
UC_FillStatement -- Teacher
UC_ViewStudents -- Teacher
UC_SearchStudent -- Teacher
UC_ViewDisciplines -- Teacher

@enduml