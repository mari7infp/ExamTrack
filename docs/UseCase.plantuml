@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam arrowColor #222222
skinparam actorBorderColor #222222
skinparam usecaseBorderColor #222222
skinparam usecaseBackgroundColor #FFFFFF

actor "Преподаватель" as Teacher
actor "Администратор" as Admin

' Наследование прав
Admin -up-|> Teacher 

rectangle "Информационная система «ExamTrack»" {
    usecase "Вход в систему (авторизация)" as UC_Login
    
    ' Задачи преподавателя
    usecase "Заполнение экзаменационной ведомости" as UC2
    usecase "Просмотр списка студентов" as UC3
    usecase "Поиск студента" as UC4
    usecase "Просмотр справочника дисциплин" as UC5
    
    ' Задачи администратора
    usecase "Регистрация пользователей" as UC6
    usecase "Добавление студента" as UC7
    usecase "Редактирование данных студента" as UC8
    usecase "Удаление студента" as UC9
    usecase "Добавление дисциплины" as UC10
    usecase "Редактирование дисциплины" as UC11
    usecase "Удаление дисциплины" as UC12
    usecase "Формирование экзаменационной ведомости" as UC13
    usecase "Закрытие экзаменационной ведомости" as UC14
    usecase "Формирование отчётов по успеваемости" as UC15
}

' Связи преподавателя
Teacher --> UC_Login
Teacher --> UC2
Teacher --> UC3
Teacher --> UC4
Teacher --> UC5

' Связи администратора
Admin --> UC_Login
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

@enduml